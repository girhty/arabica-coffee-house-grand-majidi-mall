---
const heroImageUrl = "https://lh3.googleusercontent.com/grass-cs/ACvplmPR1q3dMaMyaaS_nZpr9WLUDsLg69SqrFPkU0ZaZix292NZhv1CNIWaSE-OGTdGoJf_xhS1i-6AN_q5FlhtPfUZJmREFcul9SMLjqYknTGmBW7jqSKNTpgiQ4sGESitYEgyYddA=w426-h240-k-no";
---
<section id="hero-section" class="relative min-h-screen flex flex-col justify-end overflow-hidden grain-overlay">
  <!-- Ambient gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-espresso-900 via-espresso-800 to-espresso-700"></div>
  <div class="ambient-glow bg-espresso-500/30 top-1/4 -left-32"></div>
  <div class="ambient-glow bg-amber-500/10 top-1/2 right-0"></div>

  <!-- Hero Content -->
  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-10 pb-28 pt-32 lg:pt-40">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      
      <!-- Left: Copy -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class="clip-reveal-right" style="transition-delay: 0.3s;">
          <p class="font-mono text-[11px] sm:text-xs tracking-[0.2em] text-white/40 uppercase mb-6">
            // Specialty Coffee House
          </p>
        </div>

        <div class="overflow-hidden mb-2">
          <h1 class="clip-reveal font-display text-[42px] sm:text-[56px] md:text-[72px] lg:text-[84px] xl:text-[96px] font-black tracking-tighter leading-[0.92] uppercase" style="transition-delay: 0.5s;">
            COFFEE FOR
          </h1>
        </div>
        <div class="overflow-hidden relative mb-6">
          <h1 class="clip-reveal font-display text-[42px] sm:text-[56px] md:text-[72px] lg:text-[84px] xl:text-[96px] font-black tracking-tighter leading-[0.92] uppercase" style="transition-delay: 0.65s;">
            YOUR
          </h1>
          <span class="clip-reveal-right font-script text-[48px] sm:text-[64px] md:text-[80px] lg:text-[96px] gradient-text absolute -bottom-2 sm:bottom-0 left-2 sm:left-4 whitespace-nowrap" style="transition-delay: 0.9s;">
            moment
          </span>
        </div>

        <div class="clip-reveal" style="transition-delay: 0.8s;">
          <p class="font-body text-xs sm:text-sm tracking-wider text-white/45 uppercase max-w-md leading-relaxed mb-8">
            Carefully sourced beans and thoughtfully brewed to bring out the best in every cup.
          </p>
        </div>

        <div class="clip-reveal" style="transition-delay: 1s;">
          <a href="#menu" class="inline-flex items-center gap-3 group font-mono text-xs sm:text-sm tracking-wider uppercase text-white hover:text-amber-500 transition-colors">
            <span class="border-b border-white/30 group-hover:border-amber-500/60 pb-0.5 transition-colors">EXPLORE MENU</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: Visual -->
      <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative reveal-item" style="transition-delay: 0.6s;">
          <div class="tilt-card relative w-[280px] sm:w-[340px] lg:w-[400px] aspect-[4/3] rounded-2xl overflow-hidden border border-white/10 shadow-2xl cursor-grab active:cursor-grabbing">
            <img
              src={heroImageUrl}
              alt="Arabica Coffee House Interior"
              class="w-full h-full object-cover"
              loading="eager"
              referrerpolicy="no-referrer"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-espresso-900/80 via-transparent to-transparent"></div>
            <!-- Floating spec card -->
            <div class="absolute bottom-4 left-4 right-4 bg-white/10 backdrop-blur-md border border-white/15 rounded-xl p-4">
              <p class="font-mono text-[9px] tracking-[0.2em] text-white/40 uppercase mb-1">// In the Cup</p>
              <div class="flex items-end justify-between">
                <p class="font-display text-sm font-bold uppercase tracking-tight">House Latte</p>
                <p class="font-mono text-xs text-amber-500">$4.20</p>
              </div>
              <div class="flex gap-2 mt-2">
                <span class="font-mono text-[9px] text-white/30 px-2 py-0.5 border border-white/10 rounded-full">250 ML</span>
                <span class="font-mono text-[9px] text-white/30 px-2 py-0.5 border border-white/10 rounded-full">BREWED DAILY</span>
                <span class="font-mono text-[9px] text-white/30 px-2 py-0.5 border border-white/10 rounded-full">TO GO</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Info Bar -->
  <div class="relative z-10 border-t border-white/10">
    <div class="max-w-[1440px] mx-auto px-6 sm:px-10">
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
        <div class="flex items-center gap-4 py-4 sm:py-5 sm:pr-6">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse-dot"></span>
          <div>
            <p class="font-mono text-[10px] tracking-wider text-white/30 uppercase">Open Daily</p>
            <p class="font-mono text-xs tracking-wider text-white/70 mt-0.5">10:00 AM — 12:00 AM</p>
          </div>
        </div>
        <div class="flex items-center gap-4 py-4 sm:py-5 sm:px-6">
          <svg class="w-4 h-4 text-white/30 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          <div>
            <p class="font-mono text-[10px] tracking-wider text-white/30 uppercase">Location</p>
            <p class="font-mono text-xs tracking-wider text-white/70 mt-0.5">Grand Majidi Mall, Erbil</p>
          </div>
        </div>
        <div class="flex items-center gap-4 py-4 sm:py-5 sm:px-6 sm:justify-end">
          <a href="https://instagram.com/arabicacoffeehouse_iraq" target="_blank" rel="noopener" class="font-mono text-[10px] tracking-wider text-white/40 hover:text-amber-500 transition-colors uppercase">Instagram</a>
          <span class="text-white/10">•</span>
          <a href="tel:+9647509308185" class="font-mono text-[10px] tracking-wider text-white/40 hover:text-amber-500 transition-colors uppercase">+964 750 930 8185</a>
        </div>
      </div>
    </div>
  </div>
</section>