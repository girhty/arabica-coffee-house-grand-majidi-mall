---
const reviews = [
  {
    author: 'Niken Rai',
    rating: 5,
    text: 'The best coffee shop in town — it\'s a friendly environment that makes you joyful and relaxed. Above everything else, the baristas make good coffee and drinks. Highly recommended to visit!',
  },
  {
    author: 'Savoos',
    rating: 4,
    text: 'Recommend. The atmosphere is lively if you\'re into crowded places. The tea and nergala were excellent, and the service was incredibly warm and friendly.',
  },
  {
    author: 'Ahmed K.',
    rating: 5,
    text: 'Great place to work and enjoy premium coffee. The ambiance is perfect — spacious area with beautiful design. Will keep coming back!',
  },
];
---
<section id="testimonials" class="relative bg-espresso-900 py-24 sm:py-32 overflow-hidden">
  <div class="ambient-glow bg-amber-500/5 top-1/4 right-0"></div>
  
  <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-10">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div>
        <p class="clip-reveal-right font-mono text-[11px] tracking-[0.2em] text-white/30 uppercase mb-4" style="transition-delay:0.1s;">
          // What People Say
        </p>
        <h2 class="clip-reveal font-display text-[32px] sm:text-[40px] md:text-[48px] font-black tracking-tighter leading-[0.95] uppercase text-white" style="transition-delay:0.25s;">
          TRUSTED BY<br/>OUR GUESTS
        </h2>
      </div>
      <div class="reveal-item" style="transition-delay:0.4s;">
        <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-5 py-2.5">
          <span class="text-amber-500 text-lg">⭐</span>
          <div class="flex flex-col">
            <span class="font-display text-sm font-bold text-white">4.2 / 5</span>
            <span class="font-mono text-[9px] text-white/35 tracking-wider uppercase">245 Google Reviews</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review, i) => (
        <div class="tilt-card reveal-item bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 sm:p-8 hover:bg-white/[0.06] transition-colors" style={`transition-delay: ${0.2 + i * 0.12}s;`}>
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({length: review.rating}).map(() => (
              <span class="text-amber-500 text-sm">★</span>
            ))}
            {Array.from({length: 5 - review.rating}).map(() => (
              <span class="text-white/15 text-sm">★</span>
            ))}
          </div>
          
          <!-- Review Text -->
          <p class="font-body text-sm text-white/55 leading-relaxed mb-6">
            "{review.text}"
          </p>
          
          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-white/[0.06]">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-amber-500/30 to-espresso-600/50 flex items-center justify-center">
              <span class="font-display text-xs font-bold text-white/70">{review.author[0]}</span>
            </div>
            <div>
              <p class="font-display text-xs font-bold text-white/70">{review.author}</p>
              <p class="font-mono text-[9px] text-white/25 tracking-wider">GOOGLE REVIEW</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>