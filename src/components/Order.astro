---
const bgImage = "https://lh3.googleusercontent.com/grass-cs/AABkmLfHBc2ZYjdBC7o-oq59mQaqDZtX2NcFCUI9foz3ULSqPYpenkAc1Bm62n3li0l1LOS1BiYDX_ZuQ4K0VRSp-SId1wY0-DgGBKLs5yYh6NKZgyLdxA3kZPOadg3jBBHbvn_OLWE7=w300-h450-p-k-no";
---
<section id="order-section" class="relative min-h-[100vh] flex flex-col justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src={bgImage}
      alt="Arabica Coffee House Interior"
      class="w-full h-full object-cover"
      loading="lazy"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-espresso-900/85"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-espresso-900/90 via-espresso-900/70 to-espresso-900/90"></div>
  </div>

  <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-10 py-24 sm:py-32 w-full">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left: Copy -->
      <div class="lg:col-span-6 order-2 lg:order-1">
        <div class="overflow-hidden mb-2">
          <h2 class="clip-reveal font-display text-[36px] sm:text-[48px] md:text-[56px] lg:text-[64px] font-black tracking-tighter leading-[0.92] uppercase text-white" style="transition-delay:0.2s;">
            COFFEE FOR<br/>RIGHT NOW.
          </h2>
        </div>
        <div class="clip-reveal" style="transition-delay:0.4s;">
          <p class="font-mono text-[11px] tracking-[0.15em] text-amber-500/80 uppercase mb-4">
            We handle the craft. You handle the day.
          </p>
          <p class="font-body text-sm sm:text-base text-white/45 leading-relaxed max-w-md mb-8">
            We work to one schedule: yours. Order ahead and your cup is poured to meet you, not to sit waiting. Fresh, fast, and exactly the way you like it.
          </p>
        </div>
        <div class="clip-reveal" style="transition-delay:0.6s;">
          <a href="#" class="inline-flex items-center gap-3 group font-mono text-xs sm:text-sm tracking-wider uppercase text-white bg-amber-500 hover:bg-amber-400 text-espresso-900 font-bold rounded-full px-8 py-3.5 transition-all hover:shadow-[0_0_30px_rgba(213,140,61,0.3)]">
            <span>ORDER RIGHT NOW</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14m-6-6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: Receipt -->
      <div class="lg:col-span-6 order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative w-[280px] sm:w-[320px] reveal-item">
          <!-- Printer slot -->
          <div class="relative z-10 mx-auto w-[200px] h-4 bg-espresso-800 rounded-t-lg border border-white/5 border-b-0 shadow-lg">
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[160px] h-[2px] bg-espresso-700 rounded-full"></div>
          </div>
          
          <!-- Receipt Paper -->
          <div id="receipt-paper" class="relative bg-bone-50 text-espresso-900 rounded-b-lg shadow-2xl overflow-hidden" style="clip-path: inset(100% 0 0 0); transition: clip-path 0.1s linear;">
            <div class="p-6 sm:p-8">
              <!-- Brand -->
              <div class="text-center mb-4 pb-4 border-b border-dashed border-espresso-900/15">
                <p class="font-display text-lg font-black tracking-tight uppercase">Arabica</p>
                <p class="font-mono text-[9px] tracking-[0.2em] text-espresso-900/40 uppercase">Coffee House</p>
              </div>
              
              <!-- Order info -->
              <div class="text-center mb-4">
                <p class="font-mono text-[10px] text-espresso-900/50 tracking-wider">ORDER #00025</p>
                <p class="font-mono text-[9px] text-espresso-900/35 tracking-wider mt-1">21/05/2026 • 12:45</p>
              </div>

              <!-- Items -->
              <div class="space-y-2 mb-4 pb-4 border-b border-dashed border-espresso-900/15">
                <div class="flex justify-between font-mono text-[10px] tracking-wider">
                  <span class="text-espresso-900/70">1x ESPRESSO DOUBLE</span>
                  <span class="text-espresso-900/50">2,500 IQD</span>
                </div>
                <div class="flex justify-between font-mono text-[10px] tracking-wider">
                  <span class="text-espresso-900/70">1x ICED LATTE</span>
                  <span class="text-espresso-900/50">5,000 IQD</span>
                </div>
                <div class="flex justify-between font-mono text-[10px] tracking-wider">
                  <span class="text-espresso-900/70">1x CINNAMON ROLL</span>
                  <span class="text-espresso-900/50">4,000 IQD</span>
                </div>
              </div>

              <div class="flex justify-between font-mono text-xs font-bold tracking-wider mb-6">
                <span class="text-espresso-900">TOTAL</span>
                <span class="text-espresso-900">11,500 IQD</span>
              </div>

              <!-- Promo block -->
              <div class="bg-espresso-900 text-white rounded-lg p-4 text-center mb-4">
                <p class="font-mono text-[9px] tracking-[0.15em] text-white/50 mb-1">SKIP THE LINE.</p>
                <p class="font-display text-sm font-bold tracking-tight uppercase mb-2">ORDER AHEAD</p>
                <p class="font-mono text-[8px] tracking-wider text-white/40 mb-3">SAVE TIME. GET YOUR COFFEE FASTER.</p>
                <span class="inline-block font-mono text-[10px] tracking-wider uppercase bg-amber-500 text-espresso-900 px-4 py-1.5 rounded-full font-bold">ORDER NOW</span>
              </div>

              <!-- Barcode -->
              <div class="flex justify-center gap-[1px] mb-4">
                {Array.from({length:40}).map(() => (
                  <div class="bg-espresso-900" style={`width: ${Math.random() > 0.5 ? '2px' : '1px'}; height: 24px;`}></div>
                ))}
              </div>

              <!-- Thanks -->
              <div class="text-center">
                <p class="font-mono text-[9px] tracking-wider text-espresso-900/40 uppercase">Thank you for choosing us.</p>
                <p class="font-mono text-[8px] tracking-wider text-espresso-900/30 mt-1 uppercase">See you soon!</p>
              </div>

              <!-- Torn edge -->
              <div class="mt-4 flex justify-center">
                <svg viewBox="0 0 200 8" class="w-full h-2 text-bone-100" preserveAspectRatio="none">
                  <path d="M0,4 Q5,0 10,4 Q15,8 20,4 Q25,0 30,4 Q35,8 40,4 Q45,0 50,4 Q55,8 60,4 Q65,0 70,4 Q75,8 80,4 Q85,0 90,4 Q95,8 100,4 Q105,0 110,4 Q115,8 120,4 Q125,0 130,4 Q135,8 140,4 Q145,0 150,4 Q155,8 160,4 Q165,0 170,4 Q175,8 180,4 Q185,0 190,4 Q195,8 200,4 L200,8 L0,8 Z" fill="currentColor"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>